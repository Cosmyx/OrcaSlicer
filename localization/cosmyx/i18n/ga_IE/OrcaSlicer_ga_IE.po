"%2%"

# AI Translated
msgid ""
"The printing task exceeds the limit, supporting a maximum of 6 printers."
msgstr ""
"Sáraíonn an tasc priontála an teorainn, tacaíonn sé le 6 phrintéir ar a "
"mhéad."

# AI Translated
msgid "Elapsed time:"
msgstr "Am caite:"

# AI Translated
