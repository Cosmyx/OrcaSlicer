msgstr "Uasluas seachanta athshondais."

# AI Translated
msgid "Emit input shaping"
msgstr "Eisigh múnlú ionchuir"

# AI Translated
msgid ""
"Override firmware input shaping settings.\n"
"If disabled, firmware settings are used."
msgstr ""
"Sáraigh socruithe múnlaithe ionchuir na ndochtearraí.\n"
"Má tá sé díchumasaithe, úsáidtear socruithe na ndochtearraí."

# AI Translated
msgid "Input shaper type"
msgstr "Cineál an mhúnlóra ionchuir"

# AI Translated
msgid ""
"Choose the input shaper algorithm.\n"
"Default uses the firmware default settings.\n"
"Disable turns off input shaping in the firmware."
msgstr ""
"Roghnaigh algartam an mhúnlóra ionchuir.\n"
"Úsáideann Réamhshocrú socruithe réamhshocraithe na ndochtearraí.\n"
"Múchann Díchumasaigh múnlú ionchuir sna dochtearraí."

# AI Translated
msgid "MZV"
msgstr "MZV"

# AI Translated
msgid "ZV"
msgstr "ZV"

# AI Translated
msgid "ZVD"
msgstr "ZVD"

# AI Translated
