msgstr "Juster"

# AI Translated
msgid ""
"Raft and draft shield are not available on belt printers.\n"
"They have been disabled."
msgstr ""
"Raft og trækskjold er ikke tilgængelige på båndprintere.\n"
"De er blevet deaktiveret."

# AI Translated
msgid ""
"Layer height too small\n"
"It has been reset to 0.2"
msgstr ""
"Laghøjden er for lille\n"
"Den er nulstillet til 0.2"

