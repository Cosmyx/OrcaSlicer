# AI Translated
msgid "Volume per extruder"
msgstr "Volumen pr. ekstruder"

# AI Translated
msgid "Total filament volume extruded per extruder during the entire print."
msgstr "Samlet filamentvolumen ekstruderet pr. ekstruder under hele printet."

