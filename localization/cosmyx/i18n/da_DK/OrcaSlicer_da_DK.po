msgstr ""
"Nulbaseret indeks for den aktive parallelle IDEX/IQEX-printtilstand i "
"imex_mode_names."

# AI Translated
msgid "IDEX/IQEX active mode G-code"
msgstr "G-code for aktiv IDEX/IQEX-tilstand"

