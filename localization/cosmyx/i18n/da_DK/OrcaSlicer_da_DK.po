msgid "MakerLab name to generate this 3MF."
msgstr "MakerLab-navn til generering af denne 3MF."

# AI Translated
msgid "MakerLab version"
msgstr "MakerLab-version"

# AI Translated
msgid "MakerLab version to generate this 3MF."
msgstr "MakerLab-version til generering af denne 3MF."

# AI Translated
