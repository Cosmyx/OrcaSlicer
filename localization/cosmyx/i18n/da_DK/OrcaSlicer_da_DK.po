msgid ""
"Vector of booleans stating whether a given extruder is used in the print."
msgstr ""
"Vektor af booleske værdier, der angiver, om en given ekstruder bruges i "
"printet."

# AI Translated
msgid "Number of extruders"
msgstr "Antal ekstrudere"

