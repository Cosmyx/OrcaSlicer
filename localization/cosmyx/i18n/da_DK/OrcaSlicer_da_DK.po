msgstr "Opdel i flere objekter"

# AI Translated
msgid ""
"If enabled, compound and compsolid shapes in imported STEP files are split "
"into multiple objects.\n"
"Used as the default in the import dialog, or directly when the import dialog "
"is disabled.\n"
"Default: enabled."
msgstr ""
