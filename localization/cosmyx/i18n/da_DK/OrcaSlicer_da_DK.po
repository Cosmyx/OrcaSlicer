msgid ""
"Total number of extruders, regardless of whether they are used in the "
"current print."
msgstr "Samlet antal ekstrudere, uanset om de bruges i det aktuelle print."

# AI Translated
msgid "Has single extruder MM priming"
msgstr "Har MM-priming med én ekstruder"

# AI Translated
msgid "Are the extra multi-material priming regions used in this print?"
msgstr "Bruges de ekstra primeområder for multimateriale i dette print?"

# AI Translated
msgid "Initial no support extruder"
msgstr "Første ekstruder uden understøtning"

# AI Translated
msgid ""
"Zero-based index of the first extruder used for printing without support. "
"Same as initial_no_support_tool."
msgstr ""
"Nulbaseret indeks for den første ekstruder, der bruges til print uden "
"understøtning. Samme som initial_no_support_tool."

# AI Translated
msgid "In head wrap detect zone"
msgstr "I registreringszonen for omvikling af hovedet"

# AI Translated
msgid "Indicates if the first layer overlaps with the head wrap zone."
msgstr "Angiver, om første lag overlapper zonen for omvikling af hovedet."

# AI Translated
msgid "Current bed type"
msgstr "Aktuel pladetype"

