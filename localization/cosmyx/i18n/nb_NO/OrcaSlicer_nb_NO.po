msgstr "Brukes de ekstra primingområdene for flermateriale i denne utskriften?"

# AI Translated
msgid "Initial no support extruder"
msgstr "Første ekstruder uten støtte"

# AI Translated
msgid ""
"Zero-based index of the first extruder used for printing without support. "
"Same as initial_no_support_tool."
msgstr ""
"Nullbasert indeks for den første ekstruderen som brukes til utskrift uten "
"støtte. Samme som initial_no_support_tool."

# AI Translated
