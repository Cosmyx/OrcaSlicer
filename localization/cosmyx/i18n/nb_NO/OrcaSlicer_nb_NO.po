msgstr "Angir om første lag overlapper sonen for hodeomvikling."

# AI Translated
msgid "Current bed type"
msgstr "Gjeldende sengetype"

# AI Translated
msgid ""
"Name of the currently selected bed plate type (e.g. 'Textured PEI Plate', "
"'Smooth High Temp Plate')."
msgstr ""
"Navnet på den valgte typen byggeplate (f.eks. 'Textured PEI Plate', 'Smooth "
