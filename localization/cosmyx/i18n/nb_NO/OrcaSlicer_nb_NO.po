# AI Translated
msgid "First layer infill"
msgstr "Fyll i første lag"

# AI Translated
msgid ""
"This is the speed for the first layer except for walls and brim, such as "
"infill, gap fill and support."
msgstr ""
"Hastigheten for første lag bortsett fra vegger og brim, for eksempel fyll, "
"gapfyll og støtte."

# AI Translated
msgid "First layer travel speed"
msgstr "Forflytningshastighet for første lag"

