"Snelheid voor het opnieuw laden van filament in het mondstuk bij het "
"wisselen van extruder."

# Needs human review: copied from the nl catalogue, check it reads right for nl_BE
msgid "Use firmware retraction"
msgstr "Gebruik firmware retractie"

# Needs human review: copied from the nl catalogue, check it reads right for nl_BE
msgid ""
"This experimental setting uses G10 and G11 commands to have the firmware "
"handle the retraction. This is only supported in recent Marlin."
msgstr ""
"Deze experimentele instelling gebruikt G10 en G11 commando's voor het "
"retracten in de firmware. Dit wordt alleen ondersteunt bij de recente "
"Marlin-variant."

# Needs human review: copied from the nl catalogue, check it reads right for nl_BE
msgid "Show auto-calibration marks"
msgstr "Markeringen voor automatische kalibratie tonen"

# Needs human review: copied from the nl catalogue, check it reads right for nl_BE
msgid "Disable set remaining print time"
msgstr "Instellen van resterende printtijd uitschakelen"

# Needs human review: copied from the nl catalogue, check it reads right for nl_BE
