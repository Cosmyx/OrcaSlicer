msgstr "Cirkel - schildert alles onder het penseel, gezien vanuit de camera"

# Needs human review: copied from the nl catalogue, check it reads right for nl_BE
msgid "Sphere - paints only within a ball around the point under the cursor"
msgstr "Bol - schildert alleen binnen een bol rond het punt onder de cursor"

# Needs human review: copied from the nl catalogue, check it reads right for nl_BE
