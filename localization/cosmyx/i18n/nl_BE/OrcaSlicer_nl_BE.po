"hoeveelheid filament geëxtrudeerd."

# Needs human review: copied from the nl catalogue, check it reads right for nl_BE
msgid "Retraction speed"
msgstr "Terugtrek (retraction) snelheid"

# Needs human review: copied from the nl catalogue, check it reads right for nl_BE
msgid "Speed for retracting filament from the nozzle."
msgstr "Snelheid voor het terugtrekken van filament uit het mondstuk."

# Needs human review: copied from the nl catalogue, check it reads right for nl_BE
msgid "Deretraction speed"
msgstr "Snelheid van terugtrekken (deretraction)"

# Needs human review: copied from the nl catalogue, check it reads right for nl_BE
msgid ""
"Speed for reloading filament into the nozzle. Zero means same speed of "
"retraction."
msgstr ""
"Snelheid voor het opnieuw laden van filament in het mondstuk. Nul betekent "
"dezelfde snelheid als bij het terugtrekken."

# Needs human review: copied from the nl catalogue, check it reads right for nl_BE
msgid "Deretraction speed (extruder change)"
msgstr "Intreksnelheid (extruderwissel)"

# Needs human review: copied from the nl catalogue, check it reads right for nl_BE
msgid "Speed for reloading filament into the nozzle when switching extruder."
