"Hele model selecteren - schilder elk vlak van het model met de actieve laag"

# Needs human review: copied from the nl catalogue, check it reads right for nl_BE
msgid "Erase whole model"
msgstr "Hele model wissen"

# Needs human review: copied from the nl catalogue, check it reads right for nl_BE
