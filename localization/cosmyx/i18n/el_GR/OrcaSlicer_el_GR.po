msgstr "Νήμα που χρησιμοποιείται σε αυτή την εργασία εκτύπωσης"

# AI Translated
msgid "AMS slot used for this filament"
msgstr "Υποδοχή AMS που χρησιμοποιείται για αυτό το νήμα"

# AI Translated
msgid "Click to select AMS slot manually"
msgstr "Κάντε κλικ για να επιλέξετε υποδοχή AMS χειροκίνητα"

# AI Translated
