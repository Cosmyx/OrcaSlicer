# AI Translated
msgid "Linear deflection"
msgstr "Lineaarinen poikkeama"

# AI Translated
msgid ""
"Linear deflection used when meshing imported STEP files.\n"
"Smaller values produce higher-quality meshes but increase processing time.\n"
"Used as the default in the import dialog, or directly when the import dialog "
"is disabled.\n"
"Default: 0.003 mm."
msgstr ""
"Tuotujen STEP-tiedostojen verkotuksessa käytettävä lineaarinen poikkeama.\n"
"Pienemmät arvot tuottavat laadukkaampia verkkoja, mutta pidentävät "
"käsittelyaikaa.\n"
"Käytetään tuonti-ikkunan oletusarvona tai suoraan, kun tuonti-ikkuna ei ole "
"käytössä.\n"
"Oletus: 0,003 mm."

# AI Translated
msgid "Angle deflection"
msgstr "Kulmapoikkeama"

# AI Translated
msgid ""
"Angle deflection used when meshing imported STEP files.\n"
"Smaller values produce higher-quality meshes but increase processing time.\n"
"Used as the default in the import dialog, or directly when the import dialog "
"is disabled.\n"
"Default: 0.5."
msgstr ""
"Tuotujen STEP-tiedostojen verkotuksessa käytettävä kulmapoikkeama.\n"
"Pienemmät arvot tuottavat laadukkaampia verkkoja, mutta pidentävät "
"käsittelyaikaa.\n"
"Käytetään tuonti-ikkunan oletusarvona tai suoraan, kun tuonti-ikkuna ei ole "
"käytössä.\n"
"Oletus: 0,5."

# AI Translated
