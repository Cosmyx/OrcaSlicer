"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=1; plural=0;\n"

# AI Translated
msgid "Enter the public key."
msgstr "請輸入公鑰。"

# AI Translated
msgid "The public key must not contain spaces."
msgstr "公鑰不得包含空格。"

# AI Translated
msgid "Enter an address."
msgstr "請輸入地址。"

# AI Translated
msgid "The address must start with https:// (http:// only for localhost)."
msgstr "地址必須以 https:// 開頭（只有 localhost 才可使用 http://）。"

# AI Translated
msgid "The address has no host name."
msgstr "地址缺少主機名稱。"

# AI Translated
msgid "This address is not valid."
msgstr "此地址無效。"

# AI Translated
msgid ""
"Connect to your own cloud server instead of Cosmyx Cloud. The cloud is only "
"used when stealth mode is off."
msgstr "連接到您自己的雲端伺服器，而非 Cosmyx Cloud。只有在無痕模式關閉時才會使用雲端。"

# AI Translated
msgid "Custom Cloud Instance"
msgstr "自訂雲端實例"

# AI Translated
msgid "API address"
msgstr "API 地址"

# AI Translated
msgid "Authentication address"
msgstr "驗證地址"

# AI Translated
msgid "Web address"
msgstr "網頁地址"

# AI Translated
msgid "Public key"
msgstr "公鑰"

# AI Translated
msgid "Check the addresses and save them."
msgstr "請檢查這些地址並儲存。"

# AI Translated
msgid "Restart the application to connect to the new cloud server."
msgstr "請重新啟動應用程式以連接到新的雲端伺服器。"
