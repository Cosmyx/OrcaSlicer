msgid ""
msgstr ""
"Project-Id-Version: OrcaSlicer Cosmyx cloud-server\n"
"Language: da_DK\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

# AI Translated
msgid "Enter the public key."
msgstr "Indtast den offentlige nøgle."

# AI Translated
msgid "The public key must not contain spaces."
msgstr "Den offentlige nøgle må ikke indeholde mellemrum."

# AI Translated
msgid "Enter an address."
msgstr "Indtast en adresse."

# AI Translated
msgid "The address must start with https:// (http:// only for localhost)."
msgstr "Adressen skal begynde med https:// (http:// kun for localhost)."

# AI Translated
msgid "The address has no host name."
msgstr "Adressen har intet værtsnavn."

# AI Translated
msgid "This address is not valid."
msgstr "Denne adresse er ikke gyldig."

# AI Translated
msgid ""
"Connect to your own cloud server instead of Cosmyx Cloud. The cloud is only "
"used when stealth mode is off."
msgstr ""
"Opret forbindelse til din egen cloudserver i stedet for Cosmyx Cloud. "
"Cloudtjenesten bruges kun, når Stealth-tilstand er slået fra."

# AI Translated
msgid "Custom Cloud Instance"
msgstr "Brugerdefineret cloudinstans"

# AI Translated
msgid "API address"
msgstr "API-adresse"

# AI Translated
msgid "Authentication address"
msgstr "Godkendelsesadresse"

# AI Translated
msgid "Web address"
msgstr "Webadresse"

# AI Translated
msgid "Public key"
msgstr "Offentlig nøgle"

# AI Translated
msgid "Check the addresses and save them."
msgstr "Kontroller adresserne, og gem dem."

# AI Translated
msgid ""
"Public key that signs this server's plugin packages, 64 hexadecimal "
"characters. The server lists it at /pkg/v1/keys; check its key id with the "
"server's operator."
msgstr ""
"Offentlig nøgle, der signerer denne servers pluginpakker, 64 hexadecimale "
"tegn. Serveren viser den på /pkg/v1/keys; kontroller dens nøgle-id hos "
"serverens operatør."

# AI Translated
msgid "Plugin signing key"
msgstr "Signeringsnøgle til plugins"

# AI Translated
# Needs human review: 'digest' (hash) kept as technical term
msgid ""
"Install plugins from this server even when no signing key is pinned. Their "
"size and digest are still checked, but nothing proves who made them."
msgstr ""
"Installer plugins fra denne server, selv når der ikke er fastlåst en "
"signeringsnøgle. Deres størrelse og digest kontrolleres stadig, men intet "
"beviser, hvem der har lavet dem."

# AI Translated
msgid "Allow unverified plugins from this server"
msgstr "Tillad ikke-verificerede plugins fra denne server"

# AI Translated
#. TRN %1% is a 64-character hexadecimal key id.
#, possible-boost-format
msgid "Key id: %1%"
msgstr "Nøgle-id: %1%"

# AI Translated
msgid "The plugin signing key must be 64 hexadecimal characters."
msgstr "Signeringsnøglen til plugins skal være på 64 hexadecimale tegn."

# AI Translated
msgid ""
"The plugin signing settings were not saved: the stored ones cannot be read."
msgstr ""
"Indstillingerne for pluginsignering blev ikke gemt: de gemte indstillinger "
"kan ikke læses."

# AI Translated
msgid ""
"The API address changed: these are the plugin signing settings of the new "
"address. Check them and apply again to change them."
msgstr ""
"API-adressen er ændret: dette er indstillingerne for pluginsignering for den "
"nye adresse. Kontroller dem, og anvend igen for at ændre dem."

# AI Translated
msgid "Restart the application to connect to the new cloud server."
msgstr ""
"Genstart programmet for at oprette forbindelse til den nye cloudserver."
