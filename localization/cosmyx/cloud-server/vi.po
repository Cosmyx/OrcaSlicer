msgid ""
msgstr ""
"Project-Id-Version: OrcaSlicer Cosmyx cloud-server\n"
"Language: vi\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=1; plural=0;\n"

# AI Translated
msgid "Enter the public key."
msgstr "Nhập khóa công khai."

# AI Translated
msgid "The public key must not contain spaces."
msgstr "Khóa công khai không được chứa khoảng trắng."

# AI Translated
msgid "Enter an address."
msgstr "Nhập địa chỉ."

# AI Translated
msgid "The address must start with https:// (http:// only for localhost)."
msgstr "Địa chỉ phải bắt đầu bằng https:// (chỉ dùng http:// cho localhost)."

# AI Translated
msgid "The address has no host name."
msgstr "Địa chỉ không có tên máy chủ."

# AI Translated
msgid "This address is not valid."
msgstr "Địa chỉ này không hợp lệ."

# AI Translated
msgid ""
"Connect to your own cloud server instead of Cosmyx Cloud. The cloud is only "
"used when stealth mode is off."
msgstr ""
"Kết nối với máy chủ đám mây của riêng bạn thay vì Cosmyx Cloud. Đám mây chỉ "
"được sử dụng khi Chế độ ẩn danh tắt."

# AI Translated
# Needs human review: check 'instance' wording (phien ban vs may chu) for a custom cloud server
msgid "Custom Cloud Instance"
msgstr "Phiên bản đám mây tùy chỉnh"

# AI Translated
msgid "API address"
msgstr "Địa chỉ API"

# AI Translated
msgid "Authentication address"
msgstr "Địa chỉ xác thực"

# AI Translated
msgid "Web address"
msgstr "Địa chỉ web"

# AI Translated
msgid "Public key"
msgstr "Khóa công khai"

# AI Translated
msgid "Check the addresses and save them."
msgstr "Kiểm tra các địa chỉ và lưu chúng."

# AI Translated
msgid ""
"Public key that signs this server's plugin packages, 64 hexadecimal "
"characters. The server lists it at /pkg/v1/keys; check its key id with the "
"server's operator."
msgstr ""
"Khóa công khai dùng để ký các gói plugin của máy chủ này, gồm 64 ký tự thập "
"lục phân. Máy chủ liệt kê khóa này tại /pkg/v1/keys; hãy kiểm tra ID khóa "
"với người vận hành máy chủ."

# AI Translated
msgid "Plugin signing key"
msgstr "Khóa ký plugin"

# AI Translated
msgid ""
"Install plugins from this server even when no signing key is pinned. Their "
"size and digest are still checked, but nothing proves who made them."
msgstr ""
"Cài đặt plugin từ máy chủ này ngay cả khi chưa ghim khóa ký nào. Kích thước "
"và mã băm của chúng vẫn được kiểm tra, nhưng không có gì chứng minh ai đã "
"tạo ra chúng."

# AI Translated
msgid "Allow unverified plugins from this server"
msgstr "Cho phép plugin chưa xác minh từ máy chủ này"

# AI Translated
#. TRN %1% is a 64-character hexadecimal key id.
#, possible-boost-format
msgid "Key id: %1%"
msgstr "ID khóa: %1%"

# AI Translated
msgid "The plugin signing key must be 64 hexadecimal characters."
msgstr "Khóa ký plugin phải gồm 64 ký tự thập lục phân."

# AI Translated
msgid ""
"The plugin signing settings were not saved: the stored ones cannot be read."
msgstr "Chưa lưu cài đặt ký plugin: không thể đọc cài đặt đã lưu trước đó."

# AI Translated
msgid ""
"The API address changed: these are the plugin signing settings of the new "
"address. Check them and apply again to change them."
msgstr ""
"Địa chỉ API đã thay đổi: đây là cài đặt ký plugin của địa chỉ mới. Hãy kiểm "
"tra và áp dụng lại để thay đổi chúng."

# AI Translated
msgid "Restart the application to connect to the new cloud server."
msgstr "Khởi động lại ứng dụng để kết nối với máy chủ đám mây mới."
