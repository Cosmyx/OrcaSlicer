"Plural-Forms: nplurals=2; plural=(n != 1);\n"

# AI Translated
msgid "Enter the public key."
msgstr "Voer de openbare sleutel in."

# AI Translated
msgid "The public key must not contain spaces."
msgstr "De openbare sleutel mag geen spaties bevatten."

# AI Translated
msgid "Enter an address."
msgstr "Voer een adres in."

# AI Translated
msgid "The address must start with https:// (http:// only for localhost)."
msgstr "Het adres moet beginnen met https:// (http:// alleen voor localhost)."

# AI Translated
msgid "The address has no host name."
msgstr "Het adres bevat geen hostnaam."

# AI Translated
msgid "This address is not valid."
msgstr "Dit adres is niet geldig."

# AI Translated
msgid ""
"Connect to your own cloud server instead of Cosmyx Cloud. The cloud is only "
"used when stealth mode is off."
msgstr ""
"Maak verbinding met uw eigen cloudserver in plaats van Cosmyx Cloud. De "
"cloud wordt alleen gebruikt wanneer de Stealth-modus uitgeschakeld is."

# AI Translated
msgid "Custom Cloud Instance"
msgstr "Aangepaste cloudinstantie"

# AI Translated
msgid "API address"
msgstr "API-adres"

# AI Translated
msgid "Authentication address"
msgstr "Authenticatieadres"

# AI Translated
msgid "Web address"
msgstr "Webadres"

# AI Translated
msgid "Public key"
msgstr "Openbare sleutel"

# AI Translated
msgid "Check the addresses and save them."
msgstr "Controleer de adressen en sla ze op."

# AI Translated
msgid "Restart the application to connect to the new cloud server."
msgstr ""
"Start de toepassing opnieuw om verbinding te maken met de nieuwe cloudserver."
