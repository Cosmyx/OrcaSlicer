msgid ""
msgstr ""
"Project-Id-Version: OrcaSlicer Cosmyx cloud-server\n"
"Language: nl_BE\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

# AI Translated
msgid "Enter the public key."
msgstr "Voer de openbare sleutel in."

# AI Translated
msgid "The public key must not contain spaces."
msgstr "De openbare sleutel mag geen spaties bevatten."

# AI Translated
msgid "Enter an address."
msgstr "Voer een adres in."

# AI Translated
msgid "The address must start with https:// (http:// only for localhost)."
msgstr "Het adres moet beginnen met https:// (http:// alleen voor localhost)."

# AI Translated
msgid "The address has no host name."
msgstr "Het adres bevat geen hostnaam."

# AI Translated
msgid "This address is not valid."
msgstr "Dit adres is niet geldig."

# AI Translated
msgid ""
"Connect to your own cloud server instead of Cosmyx Cloud. The cloud is only "
"used when stealth mode is off."
msgstr ""
"Maak verbinding met uw eigen cloudserver in plaats van Cosmyx Cloud. De "
"cloud wordt alleen gebruikt wanneer de Stealth-modus uitgeschakeld is."

# AI Translated
msgid "Custom Cloud Instance"
msgstr "Aangepaste cloudinstantie"

# AI Translated
msgid "API address"
msgstr "API-adres"

# AI Translated
msgid "Authentication address"
msgstr "Authenticatieadres"

# AI Translated
msgid "Web address"
msgstr "Webadres"

# AI Translated
msgid "Public key"
msgstr "Openbare sleutel"

# AI Translated
msgid "Check the addresses and save them."
msgstr "Controleer de adressen en sla ze op."

# AI Translated
msgid ""
"Public key that signs this server's plugin packages, 64 hexadecimal "
"characters. The server lists it at /pkg/v1/keys; check its key id with the "
"server's operator."
msgstr ""
"Openbare sleutel waarmee de plug-inpakketten van deze server ondertekend "
"worden, 64 hexadecimale tekens. De server vermeldt ze op /pkg/v1/keys; "
"controleer de sleutel-ID bij de beheerder van de server."

# AI Translated
msgid "Plugin signing key"
msgstr "Ondertekeningssleutel voor plug-ins"

# AI Translated
msgid ""
"Install plugins from this server even when no signing key is pinned. Their "
"size and digest are still checked, but nothing proves who made them."
msgstr ""
"Plug-ins van deze server installeren, ook als er geen ondertekeningssleutel "
"vastgezet is. Hun grootte en hash worden nog steeds gecontroleerd, maar "
"niets bewijst wie ze gemaakt heeft."

# AI Translated
msgid "Allow unverified plugins from this server"
msgstr "Niet-geverifieerde plug-ins van deze server toestaan"

# AI Translated
#. TRN %1% is a 64-character hexadecimal key id.
#, possible-boost-format
msgid "Key id: %1%"
msgstr "Sleutel-ID: %1%"

# AI Translated
msgid "The plugin signing key must be 64 hexadecimal characters."
msgstr ""
"De ondertekeningssleutel voor plug-ins moet uit 64 hexadecimale tekens "
"bestaan."

# AI Translated
msgid ""
"The plugin signing settings were not saved: the stored ones cannot be read."
msgstr ""
"De instellingen voor de ondertekening van plug-ins werden niet opgeslagen: "
"de opgeslagen instellingen kunnen niet worden gelezen."

# AI Translated
msgid ""
"The API address changed: these are the plugin signing settings of the new "
"address. Check them and apply again to change them."
msgstr ""
"Het API-adres is gewijzigd: dit zijn de instellingen voor de ondertekening "
"van plug-ins van het nieuwe adres. Controleer ze en pas ze opnieuw toe om ze "
"te wijzigen."

# AI Translated
msgid "Restart the application to connect to the new cloud server."
msgstr ""
"Start de toepassing opnieuw om verbinding te maken met de nieuwe cloudserver."
