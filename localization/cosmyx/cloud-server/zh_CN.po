msgid ""
msgstr ""
"Project-Id-Version: OrcaSlicer Cosmyx cloud-server\n"
"Language: zh_CN\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=1; plural=0;\n"

# AI Translated
msgid "Enter the public key."
msgstr "请输入公钥。"

# AI Translated
msgid "The public key must not contain spaces."
msgstr "公钥不能包含空格。"

# AI Translated
msgid "Enter an address."
msgstr "请输入地址。"

# AI Translated
msgid "The address must start with https:// (http:// only for localhost)."
msgstr "地址必须以 https:// 开头（仅 localhost 可使用 http://）。"

# AI Translated
msgid "The address has no host name."
msgstr "该地址缺少主机名。"

# AI Translated
msgid "This address is not valid."
msgstr "该地址无效。"

# AI Translated
msgid ""
"Connect to your own cloud server instead of Cosmyx Cloud. The cloud is only "
"used when stealth mode is off."
msgstr "连接到您自己的云服务器，而非 Cosmyx Cloud。仅在隐身模式关闭时才会使用云端。"

# AI Translated
# Needs human review: check 实例 wording for a self-hosted cloud server
msgid "Custom Cloud Instance"
msgstr "自定义云实例"

# AI Translated
msgid "API address"
msgstr "API 地址"

# AI Translated
msgid "Authentication address"
msgstr "认证地址"

# AI Translated
msgid "Web address"
msgstr "网页地址"

# AI Translated
msgid "Public key"
msgstr "公钥"

# AI Translated
msgid "Check the addresses and save them."
msgstr "检查地址并保存。"

# AI Translated
msgid ""
"Public key that signs this server's plugin packages, 64 hexadecimal "
"characters. The server lists it at /pkg/v1/keys; check its key id with the "
"server's operator."
msgstr ""
"用于签名此服务器插件包的公钥，由 64 个十六进制字符组成。服务器在 /pkg/v1/keys 列出该公钥；请向服务器运营者核实其密钥 ID。"

# AI Translated
msgid "Plugin signing key"
msgstr "插件签名密钥"

# AI Translated
msgid ""
"Install plugins from this server even when no signing key is pinned. Their "
"size and digest are still checked, but nothing proves who made them."
msgstr "即使未固定签名密钥，也从此服务器安装插件。插件的大小和摘要仍会被校验，但无法证明其制作者。"

# AI Translated
msgid "Allow unverified plugins from this server"
msgstr "允许来自此服务器的未验证插件"

# AI Translated
#. TRN %1% is a 64-character hexadecimal key id.
#, possible-boost-format
msgid "Key id: %1%"
msgstr "密钥 ID：%1%"

# AI Translated
msgid "The plugin signing key must be 64 hexadecimal characters."
msgstr "插件签名密钥必须为 64 个十六进制字符。"

# AI Translated
msgid ""
"The plugin signing settings were not saved: the stored ones cannot be read."
msgstr "插件签名设置未保存：无法读取已存储的设置。"

# AI Translated
msgid ""
"The API address changed: these are the plugin signing settings of the new "
"address. Check them and apply again to change them."
msgstr "API 地址已更改：以下是新地址的插件签名设置。请检查这些设置，如需更改请再次应用。"

# AI Translated
msgid "Restart the application to connect to the new cloud server."
msgstr "请重启应用程序以连接到新的云服务器。"
