"Plural-Forms: nplurals=5; plural=(n==1 ? 0 : n==2 ? 1 : n>=3 && n<=6 ? 2 : "
"n>=7 && n<=10 ? 3 : 4);\n"

# AI Translated
msgid "Enter the public key."
msgstr "Cuir isteach an eochair phoiblí."

# AI Translated
msgid "The public key must not contain spaces."
msgstr "Níor cheart spásanna a bheith san eochair phoiblí."

# AI Translated
msgid "Enter an address."
msgstr "Cuir isteach seoladh."

# AI Translated
msgid "The address must start with https:// (http:// only for localhost)."
msgstr "Caithfidh an seoladh tosú le https:// (http:// do localhost amháin)."

# AI Translated
msgid "The address has no host name."
msgstr "Níl aon óstainm sa seoladh."

# AI Translated
msgid "This address is not valid."
msgstr "Níl an seoladh seo bailí."

# AI Translated
msgid ""
"Connect to your own cloud server instead of Cosmyx Cloud. The cloud is only "
"used when stealth mode is off."
msgstr ""
"Ceangail le do fhreastalaí néil féin in ionad Cosmyx Cloud. Ní úsáidtear an "
"néal ach nuair atá an mód folaitheach múchta."

# AI Translated
msgid "Custom Cloud Instance"
msgstr "Cás Néil Saincheaptha"

# AI Translated
msgid "API address"
msgstr "Seoladh API"

# AI Translated
msgid "Authentication address"
msgstr "Seoladh fíordheimhnithe"

# AI Translated
msgid "Web address"
msgstr "Seoladh gréasáin"

# AI Translated
msgid "Public key"
msgstr "Eochair phoiblí"

# AI Translated
msgid "Check the addresses and save them."
msgstr "Seiceáil na seoltaí agus sábháil iad."

# AI Translated
msgid "Restart the application to connect to the new cloud server."
msgstr "Atosaigh an feidhmchlár chun ceangal leis an bhfreastalaí néil nua."
