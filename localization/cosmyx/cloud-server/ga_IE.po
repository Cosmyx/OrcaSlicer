msgid ""
msgstr ""
"Project-Id-Version: OrcaSlicer Cosmyx cloud-server\n"
"Language: ga_IE\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=5; plural=(n==1 ? 0 : n==2 ? 1 : n>=3 && n<=6 ? 2 : "
"n>=7 && n<=10 ? 3 : 4);\n"

# AI Translated
msgid "Enter the public key."
msgstr "Cuir isteach an eochair phoiblí."

# AI Translated
msgid "The public key must not contain spaces."
msgstr "Níor cheart spásanna a bheith san eochair phoiblí."

# AI Translated
msgid "Enter an address."
msgstr "Cuir isteach seoladh."

# AI Translated
msgid "The address must start with https:// (http:// only for localhost)."
msgstr "Caithfidh an seoladh tosú le https:// (http:// do localhost amháin)."

# AI Translated
msgid "The address has no host name."
msgstr "Níl aon óstainm sa seoladh."

# AI Translated
msgid "This address is not valid."
msgstr "Níl an seoladh seo bailí."

# AI Translated
msgid ""
"Connect to your own cloud server instead of Cosmyx Cloud. The cloud is only "
"used when stealth mode is off."
msgstr ""
"Ceangail le do fhreastalaí néil féin in ionad Cosmyx Cloud. Ní úsáidtear an "
"néal ach nuair atá an mód folaitheach múchta."

# AI Translated
msgid "Custom Cloud Instance"
msgstr "Cás Néil Saincheaptha"

# AI Translated
msgid "API address"
msgstr "Seoladh API"

# AI Translated
msgid "Authentication address"
msgstr "Seoladh fíordheimhnithe"

# AI Translated
msgid "Web address"
msgstr "Seoladh gréasáin"

# AI Translated
msgid "Public key"
msgstr "Eochair phoiblí"

# AI Translated
msgid "Check the addresses and save them."
msgstr "Seiceáil na seoltaí agus sábháil iad."

# AI Translated
msgid ""
"Public key that signs this server's plugin packages, 64 hexadecimal "
"characters. The server lists it at /pkg/v1/keys; check its key id with the "
"server's operator."
msgstr ""
"Eochair phoiblí a shíníonn pacáistí breiseán an fhreastalaí seo, 64 "
"charachtar heicsidheachúlach. Liostaíonn an freastalaí í ag /pkg/v1/keys; "
"seiceáil aitheantas a heochrach le hoibreoir an fhreastalaí."

# AI Translated
msgid "Plugin signing key"
msgstr "Eochair shínithe breiseán"

# AI Translated
msgid ""
"Install plugins from this server even when no signing key is pinned. Their "
"size and digest are still checked, but nothing proves who made them."
msgstr ""
"Suiteáil breiseáin ón bhfreastalaí seo fiú nuair nach bhfuil eochair "
"shínithe pionnáilte. Seiceáiltear a méid agus a ndíleá fós, ach ní "
"chruthaíonn aon rud cé a rinne iad."

# AI Translated
msgid "Allow unverified plugins from this server"
msgstr "Ceadaigh breiseáin neamhfhíoraithe ón bhfreastalaí seo"

# AI Translated
#. TRN %1% is a 64-character hexadecimal key id.
#, possible-boost-format
msgid "Key id: %1%"
msgstr "Aitheantas eochrach: %1%"

# AI Translated
msgid "The plugin signing key must be 64 hexadecimal characters."
msgstr ""
"Caithfidh an eochair shínithe breiseán a bheith 64 charachtar "
"heicsidheachúlach."

# AI Translated
msgid ""
"The plugin signing settings were not saved: the stored ones cannot be read."
msgstr ""
"Níor sábháladh socruithe síniú na mbreiseán: ní féidir na cinn stóráilte a "
"léamh."

# AI Translated
msgid ""
"The API address changed: these are the plugin signing settings of the new "
"address. Check them and apply again to change them."
msgstr ""
"Athraíodh an seoladh API: seo iad socruithe síniú na mbreiseán don seoladh "
"nua. Seiceáil iad agus cuir i bhfeidhm arís iad chun iad a athrú."

# AI Translated
msgid "Restart the application to connect to the new cloud server."
msgstr "Atosaigh an feidhmchlár chun ceangal leis an bhfreastalaí néil nua."
