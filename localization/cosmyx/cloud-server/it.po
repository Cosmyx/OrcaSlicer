# AI Translated
msgid "Enter the public key."
msgstr "Inserisci la chiave pubblica."

# AI Translated
msgid "The public key must not contain spaces."
msgstr "La chiave pubblica non deve contenere spazi."

# AI Translated
msgid "Enter an address."
msgstr "Inserisci un indirizzo."

# AI Translated
msgid "The address must start with https:// (http:// only for localhost)."
msgstr "L'indirizzo deve iniziare con https:// (http:// solo per localhost)."

# AI Translated
msgid "The address has no host name."
msgstr "L'indirizzo non contiene un nome host."

# AI Translated
msgid "This address is not valid."
msgstr "Questo indirizzo non è valido."

# AI Translated
msgid ""
"Connect to your own cloud server instead of Cosmyx Cloud. The cloud is only "
"used when stealth mode is off."
msgstr ""
"Connettiti al tuo server cloud invece di Cosmyx Cloud. Il cloud viene usato "
"solo quando la Modalità Stealth è disattivata."

# AI Translated
msgid "Custom Cloud Instance"
msgstr "Istanza cloud personalizzata"

# AI Translated
msgid "API address"
msgstr "Indirizzo API"

# AI Translated
msgid "Authentication address"
msgstr "Indirizzo di autenticazione"

# AI Translated
msgid "Web address"
msgstr "Indirizzo web"

# AI Translated
msgid "Public key"
msgstr "Chiave pubblica"

# AI Translated
msgid "Check the addresses and save them."
msgstr "Verifica gli indirizzi e salvali."

# AI Translated
msgid "Restart the application to connect to the new cloud server."
msgstr "Riavvia l'applicazione per connetterti al nuovo server cloud."
