msgid ""
msgstr ""
"Project-Id-Version: OrcaSlicer Cosmyx cloud-server\n"
"Language: it\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n==1) ? 0 : 1;\n"

# AI Translated
msgid "Enter the public key."
msgstr "Inserisci la chiave pubblica."

# AI Translated
msgid "The public key must not contain spaces."
msgstr "La chiave pubblica non deve contenere spazi."

# AI Translated
msgid "Enter an address."
msgstr "Inserisci un indirizzo."

# AI Translated
msgid "The address must start with https:// (http:// only for localhost)."
msgstr "L'indirizzo deve iniziare con https:// (http:// solo per localhost)."

# AI Translated
msgid "The address has no host name."
msgstr "L'indirizzo non contiene un nome host."

# AI Translated
msgid "This address is not valid."
msgstr "Questo indirizzo non è valido."

# AI Translated
msgid ""
"Connect to your own cloud server instead of Cosmyx Cloud. The cloud is only "
"used when stealth mode is off."
msgstr ""
"Connettiti al tuo server cloud invece di Cosmyx Cloud. Il cloud viene usato "
"solo quando la Modalità Stealth è disattivata."

# AI Translated
msgid "Custom Cloud Instance"
msgstr "Istanza cloud personalizzata"

# AI Translated
msgid "API address"
msgstr "Indirizzo API"

# AI Translated
msgid "Authentication address"
msgstr "Indirizzo di autenticazione"

# AI Translated
msgid "Web address"
msgstr "Indirizzo web"

# AI Translated
msgid "Public key"
msgstr "Chiave pubblica"

# AI Translated
msgid "Check the addresses and save them."
msgstr "Verifica gli indirizzi e salvali."

# AI Translated
msgid ""
"Public key that signs this server's plugin packages, 64 hexadecimal "
"characters. The server lists it at /pkg/v1/keys; check its key id with the "
"server's operator."
msgstr ""
"Chiave pubblica che firma i pacchetti plugin di questo server, 64 caratteri "
"esadecimali. Il server la elenca in /pkg/v1/keys; verifica il suo ID chiave "
"con il gestore del server."

# AI Translated
msgid "Plugin signing key"
msgstr "Chiave di firma dei plugin"

# AI Translated
# Needs human review: 'pinned' rendered as 'fissata', 'digest' as 'hash'
msgid ""
"Install plugins from this server even when no signing key is pinned. Their "
"size and digest are still checked, but nothing proves who made them."
msgstr ""
"Installa i plugin da questo server anche quando non è fissata alcuna chiave "
"di firma. La loro dimensione e il loro hash vengono comunque verificati, ma "
"nulla prova chi li ha creati."

# AI Translated
msgid "Allow unverified plugins from this server"
msgstr "Consenti plugin non verificati da questo server"

# AI Translated
#. TRN %1% is a 64-character hexadecimal key id.
#, possible-boost-format
msgid "Key id: %1%"
msgstr "ID chiave: %1%"

# AI Translated
msgid "The plugin signing key must be 64 hexadecimal characters."
msgstr ""
"La chiave di firma dei plugin deve essere composta da 64 caratteri "
"esadecimali."

# AI Translated
msgid ""
"The plugin signing settings were not saved: the stored ones cannot be read."
msgstr ""
"Le impostazioni di firma dei plugin non sono state salvate: quelle "
"memorizzate non possono essere lette."

# AI Translated
msgid ""
"The API address changed: these are the plugin signing settings of the new "
"address. Check them and apply again to change them."
msgstr ""
"L'indirizzo API è cambiato: queste sono le impostazioni di firma dei plugin "
"del nuovo indirizzo. Verificale e applica di nuovo per modificarle."

# AI Translated
msgid "Restart the application to connect to the new cloud server."
msgstr "Riavvia l'applicazione per connetterti al nuovo server cloud."
