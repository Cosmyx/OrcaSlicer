msgid ""
msgstr ""
"Project-Id-Version: OrcaSlicer Cosmyx cloud-server\n"
"Language: es\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

# AI Translated
msgid "Enter the public key."
msgstr "Introduzca la clave pública."

# AI Translated
msgid "The public key must not contain spaces."
msgstr "La clave pública no debe contener espacios."

# AI Translated
msgid "Enter an address."
msgstr "Introduzca una dirección."

# AI Translated
msgid "The address must start with https:// (http:// only for localhost)."
msgstr "La dirección debe empezar por https:// (http:// solo para localhost)."

# AI Translated
msgid "The address has no host name."
msgstr "La dirección no tiene nombre de host."

# AI Translated
msgid "This address is not valid."
msgstr "Esta dirección no es válida."

# AI Translated
msgid ""
"Connect to your own cloud server instead of Cosmyx Cloud. The cloud is only "
"used when stealth mode is off."
msgstr ""
"Conéctese a su propio servidor en la nube en lugar de Cosmyx Cloud. La nube "
"solo se usa cuando el modo sigiloso está desactivado."

# AI Translated
msgid "Custom Cloud Instance"
msgstr "Instancia de nube personalizada"

# AI Translated
msgid "API address"
msgstr "Dirección de la API"

# AI Translated
msgid "Authentication address"
msgstr "Dirección de autenticación"

# AI Translated
msgid "Web address"
msgstr "Dirección web"

# AI Translated
msgid "Public key"
msgstr "Clave pública"

# AI Translated
msgid "Check the addresses and save them."
msgstr "Compruebe las direcciones y guárdelas."

# AI Translated
msgid ""
"Public key that signs this server's plugin packages, 64 hexadecimal "
"characters. The server lists it at /pkg/v1/keys; check its key id with the "
"server's operator."
msgstr ""
"Clave pública que firma los paquetes de plugins de este servidor, de 64 "
"caracteres hexadecimales. El servidor la publica en /pkg/v1/keys; compruebe "
"su identificador de clave con el operador del servidor."

# AI Translated
msgid "Plugin signing key"
msgstr "Clave de firma de plugins"

# AI Translated
# Needs human review: 'resumen' for digest (hash) and 'fijada' for pinned key
msgid ""
"Install plugins from this server even when no signing key is pinned. Their "
"size and digest are still checked, but nothing proves who made them."
msgstr ""
"Instalar plugins de este servidor aunque no haya ninguna clave de firma "
"fijada. Se siguen comprobando su tamaño y su resumen, pero nada demuestra "
"quién los ha creado."

# AI Translated
msgid "Allow unverified plugins from this server"
msgstr "Permitir plugins no verificados de este servidor"

# AI Translated
#. TRN %1% is a 64-character hexadecimal key id.
#, possible-boost-format
msgid "Key id: %1%"
msgstr "Identificador de clave: %1%"

# AI Translated
msgid "The plugin signing key must be 64 hexadecimal characters."
msgstr "La clave de firma de plugins debe tener 64 caracteres hexadecimales."

# AI Translated
msgid ""
"The plugin signing settings were not saved: the stored ones cannot be read."
msgstr ""
"No se ha guardado la configuración de firma de plugins: no se puede leer la "
"configuración almacenada."

# AI Translated
msgid ""
"The API address changed: these are the plugin signing settings of the new "
"address. Check them and apply again to change them."
msgstr ""
"La dirección de la API ha cambiado: esta es la configuración de firma de "
"plugins de la nueva dirección. Revísela y vuelva a aplicarla para "
"modificarla."

# AI Translated
msgid "Restart the application to connect to the new cloud server."
msgstr "Reinicie la aplicación para conectarse al nuevo servidor en la nube."
