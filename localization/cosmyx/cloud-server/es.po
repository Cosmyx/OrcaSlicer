"Project-Id-Version: OrcaSlicer Cosmyx cloud-server\n"
"Language: es\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

# AI Translated
msgid "Enter the public key."
msgstr "Introduzca la clave pública."

# AI Translated
msgid "The public key must not contain spaces."
msgstr "La clave pública no debe contener espacios."

# AI Translated
msgid "Enter an address."
msgstr "Introduzca una dirección."

# AI Translated
msgid "The address must start with https:// (http:// only for localhost)."
msgstr "La dirección debe empezar por https:// (http:// solo para localhost)."

# AI Translated
msgid "The address has no host name."
msgstr "La dirección no tiene nombre de host."

# AI Translated
msgid "This address is not valid."
msgstr "Esta dirección no es válida."

# AI Translated
msgid ""
"Connect to your own cloud server instead of Cosmyx Cloud. The cloud is only "
"used when stealth mode is off."
msgstr ""
"Conéctese a su propio servidor en la nube en lugar de Cosmyx Cloud. La nube "
"solo se usa cuando el modo sigiloso está desactivado."

# AI Translated
msgid "Custom Cloud Instance"
msgstr "Instancia de nube personalizada"

# AI Translated
msgid "API address"
msgstr "Dirección de la API"

# AI Translated
msgid "Authentication address"
msgstr "Dirección de autenticación"

# AI Translated
msgid "Web address"
msgstr "Dirección web"

# AI Translated
msgid "Public key"
msgstr "Clave pública"

# AI Translated
msgid "Check the addresses and save them."
msgstr "Compruebe las direcciones y guárdelas."

# AI Translated
msgid "Restart the application to connect to the new cloud server."
msgstr "Reinicie la aplicación para conectarse al nuevo servidor en la nube."
