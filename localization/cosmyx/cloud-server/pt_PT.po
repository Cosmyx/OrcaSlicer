"Project-Id-Version: OrcaSlicer Cosmyx cloud-server\n"
"Language: pt_PT\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

# AI Translated
msgid "Enter the public key."
msgstr "Introduza a chave pública."

# AI Translated
msgid "The public key must not contain spaces."
msgstr "A chave pública não pode conter espaços."

# AI Translated
msgid "Enter an address."
msgstr "Introduza um endereço."

# AI Translated
msgid "The address must start with https:// (http:// only for localhost)."
msgstr ""
"O endereço tem de começar por https:// (http:// apenas para localhost)."

# AI Translated
msgid "The address has no host name."
msgstr "O endereço não tem nome de anfitrião."

# AI Translated
msgid "This address is not valid."
msgstr "Este endereço não é válido."

# AI Translated
msgid ""
"Connect to your own cloud server instead of Cosmyx Cloud. The cloud is only "
"used when stealth mode is off."
msgstr ""
"Ligar ao seu próprio servidor na nuvem em vez da Cosmyx Cloud. A nuvem só é "
"usada quando o modo furtivo está desativado."

# AI Translated
msgid "Custom Cloud Instance"
msgstr "Instância de nuvem personalizada"

# AI Translated
msgid "API address"
msgstr "Endereço da API"

# AI Translated
msgid "Authentication address"
msgstr "Endereço de autenticação"

# AI Translated
msgid "Web address"
msgstr "Endereço web"

# AI Translated
msgid "Public key"
msgstr "Chave pública"

# AI Translated
msgid "Check the addresses and save them."
msgstr "Verifique os endereços e guarde-os."

# AI Translated
msgid "Restart the application to connect to the new cloud server."
msgstr "Reinicie a aplicação para se ligar ao novo servidor na nuvem."
