msgid ""
msgstr ""
"Project-Id-Version: OrcaSlicer Cosmyx cloud-server\n"
"Language: pt_PT\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

# AI Translated
msgid "Enter the public key."
msgstr "Introduza a chave pública."

# AI Translated
msgid "The public key must not contain spaces."
msgstr "A chave pública não pode conter espaços."

# AI Translated
msgid "Enter an address."
msgstr "Introduza um endereço."

# AI Translated
msgid "The address must start with https:// (http:// only for localhost)."
msgstr ""
"O endereço tem de começar por https:// (http:// apenas para localhost)."

# AI Translated
msgid "The address has no host name."
msgstr "O endereço não tem nome de anfitrião."

# AI Translated
msgid "This address is not valid."
msgstr "Este endereço não é válido."

# AI Translated
msgid ""
"Connect to your own cloud server instead of Cosmyx Cloud. The cloud is only "
"used when stealth mode is off."
msgstr ""
"Ligar ao seu próprio servidor na nuvem em vez da Cosmyx Cloud. A nuvem só é "
"usada quando o modo furtivo está desativado."

# AI Translated
msgid "Custom Cloud Instance"
msgstr "Instância de nuvem personalizada"

# AI Translated
msgid "API address"
msgstr "Endereço da API"

# AI Translated
msgid "Authentication address"
msgstr "Endereço de autenticação"

# AI Translated
msgid "Web address"
msgstr "Endereço web"

# AI Translated
msgid "Public key"
msgstr "Chave pública"

# AI Translated
msgid "Check the addresses and save them."
msgstr "Verifique os endereços e guarde-os."

# AI Translated
msgid ""
"Public key that signs this server's plugin packages, 64 hexadecimal "
"characters. The server lists it at /pkg/v1/keys; check its key id with the "
"server's operator."
msgstr ""
"Chave pública que assina os pacotes de plugins deste servidor, com 64 "
"caracteres hexadecimais. O servidor apresenta-a em /pkg/v1/keys; confirme o "
"identificador da chave com o operador do servidor."

# AI Translated
msgid "Plugin signing key"
msgstr "Chave de assinatura de plugins"

# AI Translated
msgid ""
"Install plugins from this server even when no signing key is pinned. Their "
"size and digest are still checked, but nothing proves who made them."
msgstr ""
"Instalar plugins deste servidor mesmo quando não há nenhuma chave de "
"assinatura fixada. O tamanho e o resumo criptográfico continuam a ser "
"verificados, mas nada prova quem os criou."

# AI Translated
msgid "Allow unverified plugins from this server"
msgstr "Permitir plugins não verificados deste servidor"

# AI Translated
#. TRN %1% is a 64-character hexadecimal key id.
#, possible-boost-format
msgid "Key id: %1%"
msgstr "ID da chave: %1%"

# AI Translated
msgid "The plugin signing key must be 64 hexadecimal characters."
msgstr ""
"A chave de assinatura de plugins tem de ter 64 caracteres hexadecimais."

# AI Translated
msgid ""
"The plugin signing settings were not saved: the stored ones cannot be read."
msgstr ""
"As definições de assinatura de plugins não foram guardadas: não é possível "
"ler as definições guardadas."

# AI Translated
msgid ""
"The API address changed: these are the plugin signing settings of the new "
"address. Check them and apply again to change them."
msgstr ""
"O endereço da API mudou: estas são as definições de assinatura de plugins do "
"novo endereço. Verifique-as e aplique novamente para as alterar."

# AI Translated
msgid "Restart the application to connect to the new cloud server."
msgstr "Reinicie a aplicação para se ligar ao novo servidor na nuvem."
