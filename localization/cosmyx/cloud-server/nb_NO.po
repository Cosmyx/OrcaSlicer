msgid ""
msgstr ""
"Project-Id-Version: OrcaSlicer Cosmyx cloud-server\n"
"Language: nb_NO\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

# AI Translated
msgid "Enter the public key."
msgstr "Skriv inn den offentlige nøkkelen."

# AI Translated
msgid "The public key must not contain spaces."
msgstr "Den offentlige nøkkelen kan ikke inneholde mellomrom."

# AI Translated
msgid "Enter an address."
msgstr "Skriv inn en adresse."

# AI Translated
msgid "The address must start with https:// (http:// only for localhost)."
msgstr "Adressen må begynne med https:// (http:// bare for localhost)."

# AI Translated
msgid "The address has no host name."
msgstr "Adressen har ikke noe vertsnavn."

# AI Translated
msgid "This address is not valid."
msgstr "Denne adressen er ikke gyldig."

# AI Translated
msgid ""
"Connect to your own cloud server instead of Cosmyx Cloud. The cloud is only "
"used when stealth mode is off."
msgstr ""
"Koble til din egen skyserver i stedet for Cosmyx Cloud. Skyen brukes bare "
"når skjult modus er av."

# AI Translated
msgid "Custom Cloud Instance"
msgstr "Egen skyinstans"

# AI Translated
msgid "API address"
msgstr "API-adresse"

# AI Translated
msgid "Authentication address"
msgstr "Autentiseringsadresse"

# AI Translated
msgid "Web address"
msgstr "Nettadresse"

# AI Translated
msgid "Public key"
msgstr "Offentlig nøkkel"

# AI Translated
msgid "Check the addresses and save them."
msgstr "Kontroller adressene og lagre dem."

# AI Translated
msgid ""
"Public key that signs this server's plugin packages, 64 hexadecimal "
"characters. The server lists it at /pkg/v1/keys; check its key id with the "
"server's operator."
msgstr ""
"Offentlig nøkkel som signerer programtilleggspakkene til denne serveren, 64 "
"heksadesimale tegn. Serveren viser den under /pkg/v1/keys; kontroller "
"nøkkel-ID-en med serverens operatør."

# AI Translated
msgid "Plugin signing key"
msgstr "Signeringsnøkkel for programtillegg"

# AI Translated
msgid ""
"Install plugins from this server even when no signing key is pinned. Their "
"size and digest are still checked, but nothing proves who made them."
msgstr ""
"Installer programtillegg fra denne serveren selv om ingen signeringsnøkkel "
"er festet. Størrelsen og sjekksummen kontrolleres fortsatt, men ingenting "
"beviser hvem som har laget dem."

# AI Translated
msgid "Allow unverified plugins from this server"
msgstr "Tillat ubekreftede programtillegg fra denne serveren"

# AI Translated
#. TRN %1% is a 64-character hexadecimal key id.
#, possible-boost-format
msgid "Key id: %1%"
msgstr "Nøkkel-ID: %1%"

# AI Translated
msgid "The plugin signing key must be 64 hexadecimal characters."
msgstr "Signeringsnøkkelen for programtillegg må være 64 heksadesimale tegn."

# AI Translated
msgid ""
"The plugin signing settings were not saved: the stored ones cannot be read."
msgstr ""
"Signeringsinnstillingene for programtillegg ble ikke lagret: de lagrede "
"innstillingene kan ikke leses."

# AI Translated
msgid ""
"The API address changed: these are the plugin signing settings of the new "
"address. Check them and apply again to change them."
msgstr ""
"API-adressen er endret: dette er signeringsinnstillingene for programtillegg "
"for den nye adressen. Kontroller dem og bruk dem på nytt for å endre dem."

# AI Translated
msgid "Restart the application to connect to the new cloud server."
msgstr "Start programmet på nytt for å koble til den nye skyserveren."
