"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

# AI Translated
msgid "Enter the public key."
msgstr "Skriv inn den offentlige nøkkelen."

# AI Translated
msgid "The public key must not contain spaces."
msgstr "Den offentlige nøkkelen kan ikke inneholde mellomrom."

# AI Translated
msgid "Enter an address."
msgstr "Skriv inn en adresse."

# AI Translated
msgid "The address must start with https:// (http:// only for localhost)."
msgstr "Adressen må begynne med https:// (http:// bare for localhost)."

# AI Translated
msgid "The address has no host name."
msgstr "Adressen har ikke noe vertsnavn."

# AI Translated
msgid "This address is not valid."
msgstr "Denne adressen er ikke gyldig."

# AI Translated
msgid ""
"Connect to your own cloud server instead of Cosmyx Cloud. The cloud is only "
"used when stealth mode is off."
msgstr ""
"Koble til din egen skyserver i stedet for Cosmyx Cloud. Skyen brukes bare "
"når skjult modus er av."

# AI Translated
msgid "Custom Cloud Instance"
msgstr "Egen skyinstans"

# AI Translated
msgid "API address"
msgstr "API-adresse"

# AI Translated
msgid "Authentication address"
msgstr "Autentiseringsadresse"

# AI Translated
msgid "Web address"
msgstr "Nettadresse"

# AI Translated
msgid "Public key"
msgstr "Offentlig nøkkel"

# AI Translated
msgid "Check the addresses and save them."
msgstr "Kontroller adressene og lagre dem."

# AI Translated
msgid "Restart the application to connect to the new cloud server."
msgstr "Start programmet på nytt for å koble til den nye skyserveren."
