msgid ""
msgstr ""
"Project-Id-Version: OrcaSlicer Cosmyx cloud-server\n"
"Language: fi_FI\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

# AI Translated
msgid "Enter the public key."
msgstr "Anna julkinen avain."

# AI Translated
msgid "The public key must not contain spaces."
msgstr "Julkinen avain ei saa sisältää välilyöntejä."

# AI Translated
msgid "Enter an address."
msgstr "Anna osoite."

# AI Translated
msgid "The address must start with https:// (http:// only for localhost)."
msgstr "Osoitteen on alettava https:// (http:// vain localhostille)."

# AI Translated
msgid "The address has no host name."
msgstr "Osoitteessa ei ole isäntänimeä."

# AI Translated
msgid "This address is not valid."
msgstr "Tämä osoite ei ole kelvollinen."

# AI Translated
msgid ""
"Connect to your own cloud server instead of Cosmyx Cloud. The cloud is only "
"used when stealth mode is off."
msgstr ""
"Yhdistä omaan pilvipalvelimeesi Cosmyx Cloudin sijaan. Pilveä käytetään "
"vain, kun häivetila on pois päältä."

# AI Translated
msgid "Custom Cloud Instance"
msgstr "Mukautettu pilvi-instanssi"

# AI Translated
msgid "API address"
msgstr "API-osoite"

# AI Translated
msgid "Authentication address"
msgstr "Todennusosoite"

# AI Translated
msgid "Web address"
msgstr "Verkko-osoite"

# AI Translated
msgid "Public key"
msgstr "Julkinen avain"

# AI Translated
msgid "Check the addresses and save them."
msgstr "Tarkista osoitteet ja tallenna ne."

# AI Translated
msgid ""
"Public key that signs this server's plugin packages, 64 hexadecimal "
"characters. The server lists it at /pkg/v1/keys; check its key id with the "
"server's operator."
msgstr ""
"Julkinen avain, jolla tämän palvelimen laajennuspaketit allekirjoitetaan, 64 "
"heksadesimaalimerkkiä. Palvelin listaa sen osoitteessa /pkg/v1/keys; "
"tarkista sen avaintunnus palvelimen ylläpitäjältä."

# AI Translated
msgid "Plugin signing key"
msgstr "Laajennusten allekirjoitusavain"

# AI Translated
msgid ""
"Install plugins from this server even when no signing key is pinned. Their "
"size and digest are still checked, but nothing proves who made them."
msgstr ""
"Asenna laajennuksia tältä palvelimelta, vaikka allekirjoitusavainta ei ole "
"kiinnitetty. Niiden koko ja tiiviste tarkistetaan edelleen, mutta mikään ei "
"todista, kuka ne on tehnyt."

# AI Translated
msgid "Allow unverified plugins from this server"
msgstr "Salli varmentamattomat laajennukset tältä palvelimelta"

# AI Translated
#. TRN %1% is a 64-character hexadecimal key id.
#, possible-boost-format
msgid "Key id: %1%"
msgstr "Avaintunnus: %1%"

# AI Translated
msgid "The plugin signing key must be 64 hexadecimal characters."
msgstr "Laajennusten allekirjoitusavaimen on oltava 64 heksadesimaalimerkkiä."

# AI Translated
msgid ""
"The plugin signing settings were not saved: the stored ones cannot be read."
msgstr ""
"Laajennusten allekirjoitusasetuksia ei tallennettu: tallennettuja asetuksia "
"ei voi lukea."

# AI Translated
msgid ""
"The API address changed: these are the plugin signing settings of the new "
"address. Check them and apply again to change them."
msgstr ""
"API-osoite muuttui: nämä ovat uuden osoitteen laajennusten "
"allekirjoitusasetukset. Tarkista ne ja ota käyttöön uudelleen muuttaaksesi "
"niitä."

# AI Translated
msgid "Restart the application to connect to the new cloud server."
msgstr "Käynnistä sovellus uudelleen yhdistääksesi uuteen pilvipalvelimeen."
