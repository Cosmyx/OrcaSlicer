# AI Translated
msgid "Enter the public key."
msgstr "Anna julkinen avain."

# AI Translated
msgid "The public key must not contain spaces."
msgstr "Julkinen avain ei saa sisältää välilyöntejä."

# AI Translated
msgid "Enter an address."
msgstr "Anna osoite."

# AI Translated
msgid "The address must start with https:// (http:// only for localhost)."
msgstr "Osoitteen on alettava https:// (http:// vain localhostille)."

# AI Translated
msgid "The address has no host name."
msgstr "Osoitteessa ei ole isäntänimeä."

# AI Translated
msgid "This address is not valid."
msgstr "Tämä osoite ei ole kelvollinen."

# AI Translated
msgid ""
"Connect to your own cloud server instead of Cosmyx Cloud. The cloud is only "
"used when stealth mode is off."
msgstr ""
"Yhdistä omaan pilvipalvelimeesi Cosmyx Cloudin sijaan. Pilveä käytetään "
"vain, kun häivetila on pois päältä."

# AI Translated
msgid "Custom Cloud Instance"
msgstr "Mukautettu pilvi-instanssi"

# AI Translated
msgid "API address"
msgstr "API-osoite"

# AI Translated
msgid "Authentication address"
msgstr "Todennusosoite"

# AI Translated
msgid "Web address"
msgstr "Verkko-osoite"

# AI Translated
msgid "Public key"
msgstr "Julkinen avain"

# AI Translated
msgid "Check the addresses and save them."
msgstr "Tarkista osoitteet ja tallenna ne."

# AI Translated
msgid "Restart the application to connect to the new cloud server."
msgstr "Käynnistä sovellus uudelleen yhdistääksesi uuteen pilvipalvelimeen."
