msgid ""
msgstr ""
"Project-Id-Version: OrcaSlicer Cosmyx plugin-verify\n"
"Language: nb_NO\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

# AI Translated
msgid ""
"The plugin server address is not a plain https address, so its plugins "
"cannot be verified. The plugin was not installed."
msgstr ""
"Adressen til programtilleggsserveren er ikke en vanlig https-adresse, så "
"programtilleggene kan ikke bekreftes. Programtillegget ble ikke installert."

# AI Translated
#. TRN %1% is the version offered by the server, %2% the installed version.
#, possible-boost-format
msgid ""
"Plugin version %1% is older than the installed version %2%, so it was not "
"installed."
msgstr ""
"Programtilleggsversjon %1% er eldre enn den installerte versjonen %2%, så "
"den ble ikke installert."

# AI Translated
msgid ""
"This build has no signing key for the Cosmyx plugin server, so its plugins "
"cannot be verified. The plugin was not installed."
msgstr ""
"Denne versjonen har ingen signeringsnøkkel for "
"Cosmyx-programtilleggsserveren, så programtilleggene kan ikke bekreftes. "
"Programtillegget ble ikke installert."

# AI Translated
msgid ""
"No signing key is pinned for this plugin server. Pin its key in Preferences, "
"or allow unverified plugins from it. The plugin was not installed."
msgstr ""
"Ingen signeringsnøkkel er festet for denne programtilleggsserveren. Fest "
"nøkkelen i Innstillinger, eller tillat ubekreftede programtillegg fra den. "
"Programtillegget ble ikke installert."

# AI Translated
msgid ""
"Plugin packages cannot be verified on this platform. The plugin was not "
"installed."
msgstr ""
"Programtilleggspakker kan ikke bekreftes på denne plattformen. "
"Programtillegget ble ikke installert."

# AI Translated
#. TRN %1% is a fixed code naming the failed check, such as bad_signature or sha256_mismatch.
#, possible-boost-format
msgid ""
"The plugin package failed its signature check (%1%). The plugin was not "
"installed."
msgstr ""
"Programtilleggspakken besto ikke signaturkontrollen (%1%). Programtillegget "
"ble ikke installert."

# AI Translated
#. TRN %1% is the plugin name.
#, possible-boost-format
msgid ""
"Plugin %1% was installed unverified: this server may serve unverified "
"plugins."
msgstr ""
"Programtillegget %1% ble installert ubekreftet: denne serveren kan levere "
"ubekreftede programtillegg."

# AI Translated
msgid ""
"The installed plugin package could not be recorded as the one whose "
"signature was checked, so it was removed. The plugin was not installed."
msgstr ""
"Den installerte programtilleggspakken kunne ikke registreres som den som "
"fikk signaturen kontrollert, så den ble fjernet. Programtillegget ble ikke "
"installert."
