msgid ""
msgstr ""
"Project-Id-Version: OrcaSlicer Cosmyx plugin-verify\n"
"Language: da_DK\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

# AI Translated
msgid ""
"The plugin server address is not a plain https address, so its plugins "
"cannot be verified. The plugin was not installed."
msgstr ""
"Pluginserverens adresse er ikke en almindelig https-adresse, så dens plugins "
"kan ikke verificeres. Pluginet blev ikke installeret."

# AI Translated
#. TRN %1% is the version offered by the server, %2% the installed version.
#, possible-boost-format
msgid ""
"Plugin version %1% is older than the installed version %2%, so it was not "
"installed."
msgstr ""
"Pluginversion %1% er ældre end den installerede version %2%, så den blev "
"ikke installeret."

# AI Translated
msgid ""
"This build has no signing key for the Cosmyx plugin server, so its plugins "
"cannot be verified. The plugin was not installed."
msgstr ""
"Denne build har ingen signeringsnøgle til Cosmyx-pluginserveren, så dens "
"plugins kan ikke verificeres. Pluginet blev ikke installeret."

# AI Translated
msgid ""
"No signing key is pinned for this plugin server. Pin its key in Preferences, "
"or allow unverified plugins from it. The plugin was not installed."
msgstr ""
"Der er ikke fastlåst nogen signeringsnøgle for denne pluginserver. Fastlås "
"dens nøgle i Præferencer, eller tillad ikke-verificerede plugins fra den. "
"Pluginet blev ikke installeret."

# AI Translated
msgid ""
"Plugin packages cannot be verified on this platform. The plugin was not "
"installed."
msgstr ""
"Pluginpakker kan ikke verificeres på denne platform. Pluginet blev ikke "
"installeret."

# AI Translated
#. TRN %1% is a fixed code naming the failed check, such as bad_signature or sha256_mismatch.
#, possible-boost-format
msgid ""
"The plugin package failed its signature check (%1%). The plugin was not "
"installed."
msgstr ""
"Pluginpakken bestod ikke signaturkontrollen (%1%). Pluginet blev ikke "
"installeret."

# AI Translated
#. TRN %1% is the plugin name.
#, possible-boost-format
msgid ""
"Plugin %1% was installed unverified: this server may serve unverified "
"plugins."
msgstr ""
"Plugin %1% blev installeret uden verificering: denne server kan levere "
"ikke-verificerede plugins."

# AI Translated
msgid ""
"The installed plugin package could not be recorded as the one whose "
"signature was checked, so it was removed. The plugin was not installed."
msgstr ""
"Den installerede pluginpakke kunne ikke registreres som den, hvis signatur "
"blev kontrolleret, så den blev fjernet. Pluginet blev ikke installeret."
