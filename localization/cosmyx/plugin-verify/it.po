msgid ""
msgstr ""
"Project-Id-Version: OrcaSlicer Cosmyx plugin-verify\n"
"Language: it\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n==1) ? 0 : 1;\n"

# AI Translated
msgid ""
"The plugin server address is not a plain https address, so its plugins "
"cannot be verified. The plugin was not installed."
msgstr ""
"L'indirizzo del server dei plugin non è un semplice indirizzo https, quindi "
"i suoi plugin non possono essere verificati. Il plugin non è stato "
"installato."

# AI Translated
#. TRN %1% is the version offered by the server, %2% the installed version.
#, possible-boost-format
msgid ""
"Plugin version %1% is older than the installed version %2%, so it was not "
"installed."
msgstr ""
"La versione %1% del plugin è precedente alla versione installata %2%, quindi "
"non è stata installata."

# AI Translated
msgid ""
"This build has no signing key for the Cosmyx plugin server, so its plugins "
"cannot be verified. The plugin was not installed."
msgstr ""
"Questa build non dispone di una chiave di firma per il server dei plugin "
"Cosmyx, quindi i suoi plugin non possono essere verificati. Il plugin non è "
"stato installato."

# AI Translated
# Needs human review: 'pin' rendered as 'fissare'
msgid ""
"No signing key is pinned for this plugin server. Pin its key in Preferences, "
"or allow unverified plugins from it. The plugin was not installed."
msgstr ""
"Nessuna chiave di firma è fissata per questo server dei plugin. Fissa la sua "
"chiave nelle Preferenze, oppure consenti i plugin non verificati da questo "
"server. Il plugin non è stato installato."

# AI Translated
msgid ""
"Plugin packages cannot be verified on this platform. The plugin was not "
"installed."
msgstr ""
"I pacchetti plugin non possono essere verificati su questa piattaforma. Il "
"plugin non è stato installato."

# AI Translated
#. TRN %1% is a fixed code naming the failed check, such as bad_signature or sha256_mismatch.
#, possible-boost-format
msgid ""
"The plugin package failed its signature check (%1%). The plugin was not "
"installed."
msgstr ""
"Il pacchetto plugin non ha superato la verifica della firma (%1%). Il plugin "
"non è stato installato."

# AI Translated
#. TRN %1% is the plugin name.
#, possible-boost-format
msgid ""
"Plugin %1% was installed unverified: this server may serve unverified "
"plugins."
msgstr ""
"Il plugin %1% è stato installato senza verifica: questo server può fornire "
"plugin non verificati."

# AI Translated
msgid ""
"The installed plugin package could not be recorded as the one whose "
"signature was checked, so it was removed. The plugin was not installed."
msgstr ""
"Non è stato possibile registrare il pacchetto plugin installato come quello "
"di cui è stata verificata la firma, quindi è stato rimosso. Il plugin non è "
"stato installato."
