msgid ""
msgstr ""
"Project-Id-Version: OrcaSlicer Cosmyx plugin-verify\n"
"Language: fr\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n==0 || n==1) ? 0 : 1;\n"

# AI Translated
msgid ""
"The plugin server address is not a plain https address, so its plugins "
"cannot be verified. The plugin was not installed."
msgstr ""
"L'adresse du serveur de plugins n'est pas une simple adresse https, ses "
"plugins ne peuvent donc pas être vérifiés. Le plugin n'a pas été installé."

# AI Translated
#. TRN %1% is the version offered by the server, %2% the installed version.
#, possible-boost-format
msgid ""
"Plugin version %1% is older than the installed version %2%, so it was not "
"installed."
msgstr ""
"La version %1% du plugin est plus ancienne que la version installée %2%, "
"elle n'a donc pas été installée."

# AI Translated
msgid ""
"This build has no signing key for the Cosmyx plugin server, so its plugins "
"cannot be verified. The plugin was not installed."
msgstr ""
"Cette version de l'application ne contient aucune clé de signature pour le "
"serveur de plugins Cosmyx, ses plugins ne peuvent donc pas être vérifiés. Le "
"plugin n'a pas été installé."

# AI Translated
msgid ""
"No signing key is pinned for this plugin server. Pin its key in Preferences, "
"or allow unverified plugins from it. The plugin was not installed."
msgstr ""
"Aucune clé de signature n'est épinglée pour ce serveur de plugins. Épinglez "
"sa clé dans les Préférences, ou autorisez ses plugins non vérifiés. Le "
"plugin n'a pas été installé."

# AI Translated
msgid ""
"Plugin packages cannot be verified on this platform. The plugin was not "
"installed."
msgstr ""
"Les paquets de plugins ne peuvent pas être vérifiés sur cette plateforme. Le "
"plugin n'a pas été installé."

# AI Translated
#. TRN %1% is a fixed code naming the failed check, such as bad_signature or sha256_mismatch.
#, possible-boost-format
msgid ""
"The plugin package failed its signature check (%1%). The plugin was not "
"installed."
msgstr ""
"La vérification de la signature du paquet de plugin a échoué (%1%). Le "
"plugin n'a pas été installé."

# AI Translated
#. TRN %1% is the plugin name.
#, possible-boost-format
msgid ""
"Plugin %1% was installed unverified: this server may serve unverified "
"plugins."
msgstr ""
"Le plugin %1% a été installé sans vérification : ce serveur est autorisé à "
"fournir des plugins non vérifiés."

# AI Translated
msgid ""
"The installed plugin package could not be recorded as the one whose "
"signature was checked, so it was removed. The plugin was not installed."
msgstr ""
"Le paquet de plugin installé n'a pas pu être enregistré comme celui dont la "
"signature a été vérifiée, il a donc été supprimé. Le plugin n'a pas été "
"installé."
