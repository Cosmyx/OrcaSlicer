"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

# AI Translated
msgid ""
"The machine refused the API key (HTTP 401). Check the API key in the Setup "
"tab."
msgstr ""
"Το μηχάνημα απέρριψε το κλειδί API (HTTP 401). Ελέγξτε το κλειδί API στην "
"καρτέλα Ρύθμιση."

# AI Translated
msgid "The API key is not allowed to read this information (HTTP 403)."
msgstr ""
"Το κλειδί API δεν έχει δικαίωμα ανάγνωσης αυτών των πληροφοριών (HTTP 403)."

# AI Translated
msgid "The machine does not provide this information (HTTP 404)."
msgstr "Το μηχάνημα δεν παρέχει αυτές τις πληροφορίες (HTTP 404)."

# AI Translated
msgid ""
"The machine did not answer in time. Check that it is switched on and "
"connected to the network."
msgstr ""
"Το μηχάνημα δεν απάντησε εγκαίρως. Ελέγξτε ότι είναι ενεργοποιημένο και "
"συνδεδεμένο στο δίκτυο."

# AI Translated
msgid "Could not reach the machine. Check the address and the network."
msgstr ""
"Δεν ήταν δυνατή η επικοινωνία με το μηχάνημα. Ελέγξτε τη διεύθυνση και το "
"δίκτυο."

# AI Translated
#. TRN %1% is an HTTP status code, for example 500.
#, possible-boost-format
msgid "The machine answered with an error (HTTP %1%)."
msgstr "Το μηχάνημα απάντησε με σφάλμα (HTTP %1%)."

# AI Translated
msgid "The machine sent an answer that could not be read."
msgstr "Το μηχάνημα έστειλε απάντηση που δεν ήταν δυνατό να αναγνωστεί."

# AI Translated
msgid "Enter the IP address or the host name of the machine."
msgstr ""
"Εισαγάγετε τη διεύθυνση IP ή το όνομα κεντρικού υπολογιστή του μηχανήματος."

# AI Translated
msgid "The address must not contain spaces."
msgstr "Η διεύθυνση δεν πρέπει να περιέχει κενά."

# AI Translated
msgid "Enter the address only, without http:// or https://."
msgstr "Εισαγάγετε μόνο τη διεύθυνση, χωρίς http:// ή https://."

# AI Translated
msgid "Enter the address only, without a path after it."
msgstr "Εισαγάγετε μόνο τη διεύθυνση, χωρίς διαδρομή μετά από αυτήν."

# AI Translated
msgid "The address must not contain a user name."
msgstr "Η διεύθυνση δεν πρέπει να περιέχει όνομα χρήστη."

# AI Translated
msgid "The port must be a number from 1 to 65535."
msgstr "Η θύρα πρέπει να είναι αριθμός από 1 έως 65535."

# AI Translated
msgid "This IPv4 address is not valid."
msgstr "Αυτή η διεύθυνση IPv4 δεν είναι έγκυρη."

# AI Translated
msgid "This host name is not valid."
msgstr "Αυτό το όνομα κεντρικού υπολογιστή δεν είναι έγκυρο."

# AI Translated
msgid "Setup"
msgstr "Ρύθμιση"

# AI Translated
msgid "Machine information"
msgstr "Πληροφορίες μηχανήματος"

# AI Translated
msgid "Machine IP"
msgstr "IP μηχανήματος"

# AI Translated
msgid "Test connection"
msgstr "Δοκιμή σύνδεσης"

# AI Translated
msgid ""
"Save the settings and run a successful connection test to see the machine "
"information."
msgstr ""
"Αποθηκεύστε τις ρυθμίσεις και εκτελέστε μια επιτυχή δοκιμή σύνδεσης για να "
"δείτε τις πληροφορίες του μηχανήματος."

# AI Translated
msgid "The API key must not contain spaces."
msgstr "Το κλειδί API δεν πρέπει να περιέχει κενά."

# AI Translated
msgid "Checking the connection to the saved machine..."
msgstr "Έλεγχος της σύνδεσης με το αποθηκευμένο μηχάνημα..."

# AI Translated
msgid "Testing the connection..."
msgstr "Δοκιμή της σύνδεσης..."

# AI Translated
msgid "Reading the machine information..."
msgstr "Ανάγνωση των πληροφοριών του μηχανήματος..."

# AI Translated
msgid "Identity"
msgstr "Ταυτότητα"

# AI Translated
msgid "Serial number"
msgstr "Σειριακός αριθμός"

# AI Translated
msgid "Software version"
msgstr "Έκδοση λογισμικού"

# AI Translated
msgid "Hardware version"
msgstr "Έκδοση υλικού"

# AI Translated
msgid "Installed options"
msgstr "Εγκατεστημένες επιλογές"

# AI Translated
# Needs human review: installed option name; check meaning on the machine
msgid "Speed mode"
msgstr "Λειτουργία ταχύτητας"

# AI Translated
# Needs human review: installed option (high-temperature kit); check wording
msgid "High temperature"
msgstr "Υψηλή θερμοκρασία"

# AI Translated
msgid "Heated enclosure"
msgstr "Θερμαινόμενος θάλαμος"

# AI Translated
# Needs human review: fume/air extraction unit wording (απαγωγής καπναερίων?)
msgid "Extraction system"
msgstr "Σύστημα απαγωγής"

# AI Translated
msgid "Enclosure maximum temperature"
msgstr "Μέγιστη θερμοκρασία θαλάμου"

# AI Translated
msgid "Heated bed"
msgstr "Θερμαινόμενη πλατφόρμα"

# AI Translated
msgid "Bed maximum temperature"
msgstr "Μέγιστη θερμοκρασία πλατφόρμας"

# AI Translated
# Needs human review: check UPS wording fits the label
msgid "Uninterrupted power supply"
msgstr "Τροφοδοσία αδιάλειπτης ισχύος (UPS)"

# AI Translated
msgid "Build volume"
msgstr "Όγκος εκτύπωσης"

# AI Translated
msgid "Bed probe"
msgstr "Αισθητήρας πλατφόρμας"

# AI Translated
msgid "Hot ends"
msgstr "Hotend"

# AI Translated
msgid "The machine reports no hot end."
msgstr "Το μηχάνημα δεν αναφέρει κανένα hotend."

# AI Translated
#. TRN %1% is the head number reported by the machine (0, 1, ...).
#, possible-boost-format
msgid "Head %1%"
msgstr "Κεφαλή %1%"

# AI Translated
# Needs human review: neuter agrees with hotend/ακροφύσιο; check gender in context
msgid "Hardened"
msgstr "Σκληρυμένο"

# AI Translated
msgid "Maximum temperature"
msgstr "Μέγιστη θερμοκρασία"

# AI Translated
msgid "Direct drive"
msgstr "Direct Drive"

# AI Translated
msgid "No camera"
msgstr "Χωρίς κάμερα"
