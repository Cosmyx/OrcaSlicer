# AI Translated
msgid ""
"The machine refused the API key (HTTP 401). Check the API key in the Setup "
"tab."
msgstr ""
"La machine a refusé la clé API (HTTP 401). Vérifiez la clé API dans l'onglet"
" Configuration."

# AI Translated
msgid "The API key is not allowed to read this information (HTTP 403)."
msgstr "La clé API ne permet pas de lire ces informations (HTTP 403)."

# AI Translated
msgid "The machine does not provide this information (HTTP 404)."
msgstr "La machine ne fournit pas ces informations (HTTP 404)."

# AI Translated
msgid ""
"The machine did not answer in time. Check that it is switched on and "
"connected to the network."
msgstr ""
"La machine n'a pas répondu à temps. Vérifiez qu'elle est allumée et "
"connectée au réseau."

# AI Translated
msgid "Could not reach the machine. Check the address and the network."
msgstr "Impossible de joindre la machine. Vérifiez l'adresse et le réseau."

# AI Translated
#. TRN %1% is an HTTP status code, for example 500.
#, possible-boost-format
msgid "The machine answered with an error (HTTP %1%)."
msgstr "La machine a répondu par une erreur (HTTP %1%)."

# AI Translated
msgid "The machine sent an answer that could not be read."
msgstr "La machine a envoyé une réponse illisible."

# AI Translated
msgid "Enter the IP address or the host name of the machine."
msgstr "Saisissez l'adresse IP ou le nom d'hôte de la machine."

# AI Translated
msgid "The address must not contain spaces."
msgstr "L'adresse ne doit pas contenir d'espaces."

# AI Translated
msgid "Enter the address only, without http:// or https://."
msgstr "Saisissez uniquement l'adresse, sans http:// ni https://."

# AI Translated
msgid "Enter the address only, without a path after it."
msgstr "Saisissez uniquement l'adresse, sans chemin après."

# AI Translated
msgid "The address must not contain a user name."
msgstr "L'adresse ne doit pas contenir de nom d'utilisateur."

# AI Translated
msgid "The port must be a number from 1 to 65535."
msgstr "Le port doit être un nombre de 1 à 65535."

# AI Translated
msgid "This IPv4 address is not valid."
msgstr "Cette adresse IPv4 n'est pas valide."

# AI Translated
msgid "This host name is not valid."
msgstr "Ce nom d'hôte n'est pas valide."

# AI Translated
msgid "Setup"
msgstr "Configuration"

# AI Translated
msgid "Machine information"
msgstr "Informations machine"

# AI Translated
msgid "Machine IP"
msgstr "IP de la machine"

# AI Translated
msgid "Test connection"
msgstr "Tester la connexion"

# AI Translated
msgid ""
"Save the settings and run a successful connection test to see the machine "
"information."
msgstr ""
"Enregistrez les réglages et réussissez un test de connexion pour voir les "
"informations de la machine."

# AI Translated
msgid "The API key must not contain spaces."
msgstr "La clé API ne doit pas contenir d'espaces."

# AI Translated
msgid "Checking the connection to the saved machine..."
msgstr "Vérification de la connexion à la machine enregistrée..."

# AI Translated
msgid "Testing the connection..."
msgstr "Test de la connexion..."

# AI Translated
msgid "Reading the machine information..."
msgstr "Lecture des informations de la machine..."

# AI Translated
msgid "Identity"
msgstr "Identité"

# AI Translated
msgid "Serial number"
msgstr "Numéro de série"

# AI Translated
msgid "Software version"
msgstr "Version du logiciel"

# AI Translated
msgid "Hardware version"
msgstr "Version du matériel"

# AI Translated
msgid "Installed options"
msgstr "Options installées"

# AI Translated
# Needs human review: machine option name shown with a raw value such as 'speed'
msgid "Speed mode"
msgstr "Mode de vitesse"

# AI Translated
msgid "High temperature"
msgstr "Haute température"

# AI Translated
msgid "Heated enclosure"
msgstr "Caisson chauffé"

# AI Translated
msgid "Extraction system"
msgstr "Système d'extraction"

# AI Translated
msgid "Enclosure maximum temperature"
msgstr "Température maximale du caisson"

# AI Translated
msgid "Heated bed"
msgstr "Plateau chauffant"

# AI Translated
msgid "Bed maximum temperature"
msgstr "Température maximale du plateau"

# AI Translated
# Needs human review: UPS as an installed option: 'Onduleur' vs 'Alimentation sans interruption'
msgid "Uninterrupted power supply"
msgstr "Onduleur"

# AI Translated
msgid "Build volume"
msgstr "Volume d'impression"

# AI Translated
msgid "Bed probe"
msgstr "Palpeur du plateau"

# AI Translated
msgid "Hot ends"
msgstr "Hotends"

# AI Translated
msgid "The machine reports no hot end."
msgstr "La machine n'indique aucun hotend."

# AI Translated
#. TRN %1% is the head number reported by the machine (0, 1, ...).
#, possible-boost-format
msgid "Head %1%"
msgstr "Tête %1%"

# AI Translated
# Needs human review: nozzle hardness (hardened steel); check gender and wording
msgid "Hardened"
msgstr "Trempé"

# AI Translated
msgid "Maximum temperature"
msgstr "Température maximale"

# AI Translated
msgid "Direct drive"
msgstr "Entraînement direct"

# AI Translated
msgid "No camera"
msgstr "Pas de caméra"