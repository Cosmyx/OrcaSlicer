msgstr ""
"Project-Id-Version: OrcaSlicer Cosmyx printer-connection\n"
"Language: es\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

# AI Translated
msgid ""
"The machine refused the API key (HTTP 401). Check the API key in the Setup "
"tab."
msgstr ""
"La máquina ha rechazado la clave API (HTTP 401). Compruebe la clave API en "
"la pestaña Configuración."

# AI Translated
msgid "The API key is not allowed to read this information (HTTP 403)."
msgstr "La clave API no tiene permiso para leer esta información (HTTP 403)."

# AI Translated
msgid "The machine does not provide this information (HTTP 404)."
msgstr "La máquina no proporciona esta información (HTTP 404)."

# AI Translated
msgid ""
"The machine did not answer in time. Check that it is switched on and "
"connected to the network."
msgstr ""
"La máquina no ha respondido a tiempo. Compruebe que está encendida y "
"conectada a la red."

# AI Translated
msgid "Could not reach the machine. Check the address and the network."
msgstr ""
"No se ha podido contactar con la máquina. Compruebe la dirección y la red."

# AI Translated
#. TRN %1% is an HTTP status code, for example 500.
#, possible-boost-format
msgid "The machine answered with an error (HTTP %1%)."
msgstr "La máquina ha respondido con un error (HTTP %1%)."

# AI Translated
msgid "The machine sent an answer that could not be read."
msgstr "La máquina ha enviado una respuesta que no se ha podido leer."

# AI Translated
msgid "Enter the IP address or the host name of the machine."
msgstr "Introduzca la dirección IP o el nombre de host de la máquina."

# AI Translated
msgid "The address must not contain spaces."
msgstr "La dirección no debe contener espacios."

# AI Translated
msgid "Enter the address only, without http:// or https://."
msgstr "Introduzca solo la dirección, sin http:// ni https://."

# AI Translated
msgid "Enter the address only, without a path after it."
msgstr "Introduzca solo la dirección, sin ninguna ruta detrás."

# AI Translated
msgid "The address must not contain a user name."
msgstr "La dirección no debe contener un nombre de usuario."

# AI Translated
msgid "The port must be a number from 1 to 65535."
msgstr "El puerto debe ser un número entre 1 y 65535."

# AI Translated
msgid "This IPv4 address is not valid."
msgstr "Esta dirección IPv4 no es válida."

# AI Translated
msgid "This host name is not valid."
msgstr "Este nombre de host no es válido."

# AI Translated
msgid "Setup"
msgstr "Configuración"

# AI Translated
msgid "Machine information"
msgstr "Información de la máquina"

# AI Translated
msgid "Machine IP"
msgstr "IP de la máquina"

# AI Translated
msgid "Test connection"
msgstr "Probar conexión"

# AI Translated
msgid ""
"Save the settings and run a successful connection test to see the machine "
"information."
msgstr ""
"Guarde los ajustes y realice una prueba de conexión correcta para ver la "
"información de la máquina."

# AI Translated
msgid "The API key must not contain spaces."
msgstr "La clave API no debe contener espacios."

# AI Translated
msgid "Checking the connection to the saved machine..."
msgstr "Comprobando la conexión con la máquina guardada..."

# AI Translated
msgid "Testing the connection..."
msgstr "Probando la conexión..."

# AI Translated
msgid "Reading the machine information..."
msgstr "Leyendo la información de la máquina..."

# AI Translated
# Needs human review: section heading for model/serial/versions; check 'Identificación' fits
msgid "Identity"
msgstr "Identificación"

# AI Translated
msgid "Serial number"
msgstr "Número de serie"

# AI Translated
msgid "Software version"
msgstr "Versión de software"

# AI Translated
msgid "Hardware version"
msgstr "Versión de hardware"

# AI Translated
msgid "Installed options"
msgstr "Opciones instaladas"

# AI Translated
# Needs human review: installed option name; check meaning (high-speed kit?)
msgid "Speed mode"
msgstr "Modo de velocidad"

# AI Translated
# Needs human review: installed option name (high-temperature kit); check wording
msgid "High temperature"
msgstr "Alta temperatura"

# AI Translated
# Needs human review: enclosure rendered as 'recámara' per reference chamber term; check
msgid "Heated enclosure"
msgstr "Recámara calefactada"

# AI Translated
msgid "Extraction system"
msgstr "Sistema de extracción"

# AI Translated
msgid "Enclosure maximum temperature"
msgstr "Temperatura máxima de la recámara"

# AI Translated
msgid "Heated bed"
msgstr "Cama caliente"

# AI Translated
msgid "Bed maximum temperature"
msgstr "Temperatura máxima de la cama"

# AI Translated
msgid "Uninterrupted power supply"
msgstr "Sistema de alimentación ininterrumpida"

# AI Translated
msgid "Build volume"
msgstr "Volumen de impresión"

# AI Translated
msgid "Bed probe"
msgstr "Sonda de cama"

# AI Translated
msgid "Hot ends"
msgstr "Hotends"

# AI Translated
msgid "The machine reports no hot end."
msgstr "La máquina no indica ningún hotend."

# AI Translated
#. TRN %1% is the head number reported by the machine (0, 1, ...).
#, possible-boost-format
msgid "Head %1%"
msgstr "Cabezal %1%"

# AI Translated
# Needs human review: hot end property (hardened nozzle); check gender/wording 'Endurecido'
msgid "Hardened"
msgstr "Endurecido"

# AI Translated
msgid "Maximum temperature"
msgstr "Temperatura máxima"

# AI Translated
msgid "Direct drive"
msgstr "Extrusor directo"

# AI Translated
msgid "No camera"
msgstr "Sin cámara"
