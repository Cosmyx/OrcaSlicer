msgid "Ironing temperature"
msgstr "Temperatura de alisamento"

# Needs human review: copied from the pt_BR catalogue, check it reads right for pt_PT
msgid ""
"Nozzle temperature while this filament irons. The nozzle goes back to the "
"print temperature once ironing is done. 0 means no change."
msgstr ""
"Temperatura do bico enquanto este filamento realiza o alisamento. O bico "
"volta à temperatura de impressão assim que o alisamento termina. 0 significa "
"sem alteração."
